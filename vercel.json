{
  "version": 2,
  "builds": [
    { "src": "api/sales.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "styles.css", "use": "@vercel/static" },
    { "src": "pos.js", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/sales", "dest": "/api/sales.js" },
    { "src": "/styles.css", "dest": "/styles.css" },
    { "src": "/pos.js", "dest": "/pos.js" },
    { "src": "/app.js", "dest": "/app.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
